{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": ["dist", "coverage"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/glyph", "**/glyph/**"],
            "message": "アプリからは公開 API の 'fupf-glyph' を import する (src/glyph への直接 import 禁止)"
          }
        ]
      }
    ]
  }
}
