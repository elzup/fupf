{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "src/glyph",
    "outDir": "lib/esm"
  },
  "include": ["src/glyph/**/*.ts"],
  "exclude": ["src/glyph/**/*.test.ts"]
}
